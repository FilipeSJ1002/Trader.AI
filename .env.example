# ==========================================
# 📌 COMANDOS ÚTEIS (Copie e cole no terminal)
# ==========================================
# 1. Criar o ambiente virtual (Rode apenas na 1ª vez):
# python -m venv venv
#
# 2. Ativar o ambiente virtual (Rode SEMPRE que abrir o projeto):
# .\venv\Scripts\activate      # (Windows CMD)
# .\venv\Scripts\Activate.ps1  # (Windows PowerShell)
# source venv/bin/activate     # (Linux/Mac)
#
# 3. Instalar/Atualizar bibliotecas:
# pip install -r requirements.txt
#
# 4. Verificar o Saldo da Carteira (Binance Testnet):
# python teste_saldo.py
#
# 5. Rodar a Inteligência em Tempo Real (Servidor Principal):
# uvicorn main:app --reload
#
# ==========================================

ENVIRONMENT=development

# Altere para data/ETHUSDT_1m.parquet ou data/XRPUSDT_1m.parquet para testar outras moedas
DATA_FILE_PATH=data/BTCUSDT_1m.parquet

# CREDENCIAIS DA BINANCE (Testnet)
# Gere suas chaves fictícias e gratuitas em: https://testnet.binance.vision/
BINANCE_API_KEY=
BINANCE_SECRET_KEY=