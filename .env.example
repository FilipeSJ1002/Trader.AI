# ==========================================================================
#  COMANDOS ÚTEIS DO TRADER.AI  (copie e cole no terminal, na raiz do projeto)
#  Atualizado: 28/07/2026 — era V6 (executor Binance Futures)
# ==========================================================================
#
# --------------------------------------------------------------------------
# 1. AMBIENTE
# --------------------------------------------------------------------------
# Criar o ambiente virtual (só na 1ª vez):
#   python -m venv venv
#
# Ativar o ambiente (SEMPRE que abrir o projeto):
#   .\venv\Scripts\Activate.ps1     # PowerShell
#   .\venv\Scripts\activate         # CMD
#   source venv/bin/activate        # Linux/Mac
#
# Instalar/atualizar bibliotecas:
#   pip install -r requirements.txt
#
# --------------------------------------------------------------------------
# 2. TREINO DA REDE NEURAL  (GPU — compartilhada com o uso do PC)
# --------------------------------------------------------------------------
# LIGAR (ou retomar do último checkpoint — nunca perde progresso):
#   python v5_train.py --data data_v6 --model-out v6_model.pth --log v6_training.log --label V6.0 --resume --batch 192
#
# LIGAR EM SEGUNDO PLANO (janela minimizada, junto com o paper trading):
#   .\religar_trader.cmd
#
# ACOMPANHAR AO VIVO (uma linha por época; Ctrl+C só encerra a visualização):
#   Get-Content v6_training.log -Wait -Tail 30
#
# PAUSAR (congela o treino e LIBERA A GPU inteira, sem perder progresso):
#   .\treino_pausar.cmd
#
# RETOMAR depois da pausa:
#   .\treino_retomar.cmd
#
# PARAR DE VEZ (encerra o processo; o checkpoint já está salvo em disco):
#   Get-CimInstance Win32_Process -Filter "Name='python.exe'" | Where-Object { $_.CommandLine -like '*v5_train.py*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }
#
# VER SE A GPU ESTÁ OCUPADA (0 MiB = nenhum treino rodando):
#   nvidia-smi
#
# TREINAR DO ZERO (apaga o checkpoint antes — cuidado, ~12h de GPU):
#   Remove-Item v6_model.pth, v6_model.pth.meta.json
#
# --------------------------------------------------------------------------
# 3. PAPER TRADING (dinheiro simulado, roda em CPU, ciclo de 15 min)
# --------------------------------------------------------------------------
# Ligar:
#   python v5_live.py
#
# Acompanhar ao vivo:
#   Get-Content v5_live.log -Wait -Tail 20
#
# Parar:
#   Get-CimInstance Win32_Process -Filter "Name='python.exe'" | Where-Object { $_.CommandLine -like '*v5_live.py*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }
#
# --------------------------------------------------------------------------
# 4. EXECUÇÃO REAL — BINANCE FUTURES TESTNET (etapa atual)
# --------------------------------------------------------------------------
# Só inspecionar a conta (não envia nada):
#   python v6_executor.py --status
#
# 1 ciclo em DRY-RUN (mostra o que faria):
#   python v6_executor.py --once
#
# 1 ciclo ENVIANDO ORDENS de verdade (testnet, dinheiro fictício):
#   python v6_executor.py --once --armar
#
# Loop contínuo na testnet (a cada 15 min):
#   python v6_executor.py --armar
#
# Fechar posições (botão de emergência):
#   python v6_executor.py --fechar BTCUSDT
#   python v6_executor.py --fechar-tudo
#
# Acompanhar o log do executor:
#   Get-Content relatorios\v6_executor.log -Wait -Tail 30
#
# Ajuda sobre as chaves da testnet de futuros:
#   python v6_executor.py --ajuda-chaves
#
# --------------------------------------------------------------------------
# 5. BACKTEST E VALIDAÇÃO
# --------------------------------------------------------------------------
# Teste (2026) com a configuração oficial:
#   python v5_backtest.py --model v5_model_b.pth
#
# Validação (H2 2025) — é AQUI que se ajustam parâmetros, nunca no teste:
#   python v5_backtest.py --model v5_model_b.pth --val
#
# Modelo V6 (26 features) — precisa do featset casado:
#   python v5_backtest.py --model v6_model.pth --featset v6 --val
#
# Ablação (quanto a rede neural realmente agrega):
#   python v5_backtest.py --model v5_model_b.pth --ablacao sem_nn
#
# Calibração do dir_conf:
#   python v6_calibracao.py --model v5_model_b.pth --split val
#
# --------------------------------------------------------------------------
# 6. DADOS
# --------------------------------------------------------------------------
# Atualizar os parquets até hoje:
#   python v6_refresh_dados.py
#
# Gerar os datasets de treino (V6, 26 features):
#   python v6_data_prep.py
#
# --------------------------------------------------------------------------
# 7. DIAGNÓSTICO DO PROJETO
# --------------------------------------------------------------------------
# Varredura completa (sintaxe, imports, arquivos, linter, processos):
#   python v6_diagnostico.py --salvar
#
# Erros de tipo iguais aos do VSCode (regras silenciadas: pyrightconfig.json):
#   npx -y pyright@latest
#
# ==========================================================================


ENVIRONMENT=development

# Altere para data/ETHUSDT_1m.parquet ou data/XRPUSDT_1m.parquet para testar outras moedas
DATA_FILE_PATH=data/BTCUSDT_1m.parquet

# CREDENCIAIS DA BINANCE — TESTNET SPOT (bot V4 / teste_saldo.py)
# Gere chaves fictícias e gratuitas em: https://testnet.binance.vision/
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# CREDENCIAIS DA BINANCE — TESTNET DE FUTUROS (v6_executor.py)
# ATENÇÃO: é uma testnet SEPARADA, com conta e chaves próprias.
# Usar a chave de spot num endpoint de futuros retorna APIError -2015.
# 1. Acesse https://testnet.binancefuture.com/
# 2. Entre com GitHub ou Google (conta independente da Binance real)
# 3. Role até o rodapé -> aba "API Key"
# 4. Copie a API Key e a Secret Key para as variáveis abaixo
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_SECRET_KEY=
